PORT=5000
CLIENT_URL=http://localhost:5173
GROQ_API_KEY=your_groq_api_key_here
DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5432/your_db_name?schema=public"
# DATABASE_URL=postgresql://your_production_db_user:your_production_db_password@localhost:5432/your_production_db_name?schema=public
# SetEnv DATABASE_URL "postgresql://your_production_db_user:your_production_db_password@127.0.0.1:5432/your_production_db_name?schema=public"

JWT_SECRET="your_jwt_secret_here"
NODE_ENV=development
SEED_DEFAULT_PASSWORD=your_default_seed_password_here
