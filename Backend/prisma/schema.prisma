generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  MANAGER
  FIELD_AUDITOR
}

enum StoreType {
  FMCG
  FRESH
  BOTH
}

enum SurveyPeriodStatus {
  DRAFT
  OPEN
  CLOSED
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AuditStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NEEDS_REVIEW
}

enum ProductAvailability {
  AVAILABLE
  OUT_OF_STOCK
  NOT_FOUND
}

enum SyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
}

enum ObservationReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

enum PriceAction {
  PRICE_DOWN
  PRICE_UP
  KEEP
  REVIEW
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================================
// USER
// ============================================================

model User {
  id           String  @id @default(uuid())
  name         String
  email        String? @unique
  phone        String  @unique
  passwordHash String?
  role         Role    @default(FIELD_AUDITOR)
  active       Boolean @default(true)

  assignments     SurveyAssignment[] @relation("AssignedAuditor")
  createdAudits   Audit[]            @relation("AuditCreatedBy")
  observations    PriceObservation[] @relation("ObservedBy")
  reviewedRecords PriceObservation[] @relation("ReviewedBy")
  alertsResolved  Alert[]            @relation("ResolvedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, active])
  @@index([active])
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id          String  @id
  name        String
  description String?
  sku         String?
  barcode     String?
  category    String
  unit        String  @default("kg")
  active      Boolean @default(true)

  assignmentItems AssignmentItem[]
  queensPrices    QueensPrice[]
  observations    PriceObservation[]
  analyses        PriceAnalysis[]
  alerts          Alert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, active])
  @@index([sku])
  @@index([barcode])
  @@index([active])
}

// ============================================================
// COMPETITOR
// ============================================================

model Competitor {
  id     String    @id
  name   String
  type   StoreType
  active Boolean   @default(true)

  stores Store[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// ============================================================
// PHYSICAL STORE / MARKET
// ============================================================

model Store {
  id           String     @id @default(uuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Restrict)

  name    String
  address String?
  city    String?
  area    String?
  type    StoreType
  active  Boolean   @default(true)

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  assignments SurveyAssignment[]
  audits      Audit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitorId, active])
  @@index([type, active])
  @@index([latitude, longitude])
}

// ============================================================
// SURVEY PERIOD
// ============================================================

model SurveyPeriod {
  id        String             @id
  name      String
  startDate DateTime
  endDate   DateTime
  status    SurveyPeriodStatus @default(DRAFT)

  assignments SurveyAssignment[]
  audits      Audit[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  priceAnalyses PriceAnalysis[]
  alerts        Alert[]

  @@index([status])
  @@index([startDate, endDate])
}

// ============================================================
// SURVEY ASSIGNMENT
// ============================================================

model SurveyAssignment {
  id String @id @default(uuid())

  auditorId String
  auditor   User   @relation("AssignedAuditor", fields: [auditorId], references: [id], onDelete: Restrict)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  surveyPeriodId String
  surveyPeriod   SurveyPeriod @relation(fields: [surveyPeriodId], references: [id], onDelete: Restrict)

  status AssignmentStatus @default(NOT_STARTED)

  assignedAt  DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  items  AssignmentItem[]
  audits Audit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([auditorId, storeId, surveyPeriodId])
  @@index([auditorId, status])
  @@index([storeId, surveyPeriodId])
  @@index([surveyPeriodId, status])
}

// ============================================================
// ASSIGNMENT ITEM
// ============================================================

model AssignmentItem {
  id String @id @default(uuid())

  assignmentId String
  assignment   SurveyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  required Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([assignmentId, productId])
  @@index([productId])
  @@index([assignmentId])
}

// ============================================================
// FIELD AUDIT / STORE VISIT
// ============================================================

model Audit {
  id String @id @default(uuid())

  assignmentId String
  assignment   SurveyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  auditorId String
  auditor   User   @relation("AuditCreatedBy", fields: [auditorId], references: [id], onDelete: Restrict)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  surveyPeriodId String
  surveyPeriod   SurveyPeriod @relation(fields: [surveyPeriodId], references: [id], onDelete: Restrict)

  status AuditStatus @default(NOT_STARTED)

  startedAt   DateTime?
  completedAt DateTime?

  startLatitude  Decimal? @db.Decimal(10, 7)
  startLongitude Decimal? @db.Decimal(10, 7)

  endLatitude  Decimal? @db.Decimal(10, 7)
  endLongitude Decimal? @db.Decimal(10, 7)

  startAccuracyMeters Decimal? @db.Decimal(8, 2)
  endAccuracyMeters   Decimal? @db.Decimal(8, 2)

  distanceFromStoreMeters Decimal? @db.Decimal(10, 2)
  gpsValid                Boolean?

  notes String?

  observations PriceObservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignmentId])
  @@index([auditorId, createdAt])
  @@index([storeId, createdAt])
  @@index([surveyPeriodId, status])
}

// ============================================================
// QUEENS PRICE HISTORY
// ============================================================

model QueensPrice {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  price Decimal @db.Decimal(12, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  source String?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, effectiveFrom])
  @@index([productId, effectiveTo])
}

// ============================================================
// COMPETITOR PRICE OBSERVATION
// ============================================================

model PriceObservation {
  id String @id @default(uuid())

  // Offline PWA generated ID.
  // Prevents duplicate submissions during retry.
  clientObservationId String @unique

  auditId String
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Restrict)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  auditorId String
  auditor   User   @relation("ObservedBy", fields: [auditorId], references: [id], onDelete: Restrict)

  availability ProductAvailability @default(AVAILABLE)

  price Decimal? @db.Decimal(12, 2)

  observedUnit String?
  packageSize  String?

  capturedAt DateTime

  syncStatus SyncStatus @default(PENDING)

  syncAttempts      Int       @default(0)
  lastSyncAttemptAt DateTime?
  syncedAt          DateTime?
  syncError         String?

  evidencePhotoUrl String?
  notes            String?

  reviewStatus ObservationReviewStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?   @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt DateTime?
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auditId])
  @@index([productId, capturedAt])
  @@index([auditorId, capturedAt])
  @@index([syncStatus])
  @@index([reviewStatus])
  @@index([availability])
}

// ============================================================
// PRICE ANALYSIS
// ============================================================

model PriceAnalysis {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  surveyPeriodId String
  surveyPeriod   SurveyPeriod @relation(fields: [surveyPeriodId], references: [id], onDelete: Restrict)

  queensPrice Decimal @db.Decimal(12, 2)

  minimumCompetitorPrice Decimal? @db.Decimal(12, 2)

  competitorAveragePrice Decimal? @db.Decimal(12, 2)

  priceIndex Decimal? @db.Decimal(8, 2)

  targetIndex Decimal? @db.Decimal(8, 2)

  action PriceAction?

  calculatedAt DateTime @default(now())

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, surveyPeriodId])
  @@index([surveyPeriodId, action])
  @@index([productId, calculatedAt])
}

// ============================================================
// PRICE ALERT
// ============================================================

model Alert {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  surveyPeriodId String?
  surveyPeriod   SurveyPeriod? @relation(fields: [surveyPeriodId], references: [id], onDelete: SetNull)

  type     PriceAction
  severity AlertSeverity @default(MEDIUM)

  message String

  queensPrice Decimal @db.Decimal(12, 2)

  competitorPrice Decimal? @db.Decimal(12, 2)

  priceIndex Decimal? @db.Decimal(8, 2)

  resolved Boolean @default(false)

  resolvedById String?
  resolvedBy   User?   @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resolved, severity])
  @@index([surveyPeriodId, type])
  @@index([productId, createdAt])
}
